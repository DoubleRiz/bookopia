POSTGRES_USER=bookopia
POSTGRES_PASSWORD=bookopia
POSTGRES_DB=bookopia

# Depuis le poste de développement. En conteneur, Compose remplace l'hôte par « db ».
DATABASE_URL=postgresql://bookopia:bookopia@localhost:5432/bookopia

PORT_API=3000

# Façade Caddy (profil « app »). Sur le VPS : ADRESSE_SITE=nom de domaine, PORT_HTTP=80, PORT_HTTPS=443.
ADRESSE_SITE=
PORT_HTTP=8080
PORT_HTTPS=8443
DOSSIER_FICHIERS=./donnees/fichiers
