# Supabase, lu par le front. Valeurs locales affichées par « supabase status » (API_URL, ANON_KEY).
# Seule la clé anon va ici : la clé service_role ne doit jamais être utilisée par l'application.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Google Photos : ID client Web OAuth (Google Cloud Console), pour http://localhost:5173. Optionnel : sans lui, seul l'import local est proposé.
VITE_GOOGLE_CLIENT_ID=
